        {
          "id": "697c6ab9-730f-484b-b693-ae23e435680b",
          "name": "Request Reference Data for One or More Securities and Fields.",
          "request": {
            "name": "Request Reference Data for One or More Securities and Fields.",
            "description": {
              "content": "Sends a `ReferenceDataRequest` to the `//blp/refdata` service to retrieve current\nreference, descriptive, fundamental, and pricing field values for up to thousands of\nsecurities at once. Limited to 400 fields per request; the API will internally split\nsecurities into groups of 10 and fields into groups of 128 against the session's\n`MaxPendingRequests` (default 1024). Supports field overrides, EID return, formatted\nvalues, UTC timestamps, and forced delayed pricing.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "refdata",
                "ReferenceDataRequest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
