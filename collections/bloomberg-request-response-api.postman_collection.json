        {
          "id": "83a16630-7b64-4432-ab03-b2ca5b5567b9",
          "name": "Request End-of-day Historical Data for One or More Securities.",
          "request": {
            "name": "Request End-of-day Historical Data for One or More Securities.",
            "description": {
              "content": "Sends a `HistoricalDataRequest` to the `//blp/refdata` service for end-of-day time\nseries data. Limited to 25 fields per request. Supports periodicity selection\n(daily/weekly/monthly/quarterly/semi-annually/yearly), periodicity adjustment\n(ACTUAL/CALENDAR/FISCAL), currency conversion, non-trading day fill options,\ncorporate action adjustments (normal, abnormal, split, DPDF), and a maximum data\npoint cap.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "refdata",
