          "item": [
            {
              "name": "Request Reference Data for One or More Securities and Fields.",
              "id": "41c33937-1dcc-48d5-a998-c6f5a203199b",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"value\": \"reference ../json-schema/blpapi-core-messages-schema.json#/$defs/ReferenceDataRequest not found in the OpenAPI spec\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/refdata/ReferenceDataRequest",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "refdata",
                    "ReferenceDataRequest"
                  ]
                },
                "description": "Sends a `ReferenceDataRequest` to the `//blp/refdata` service to retrieve current\nreference, descriptive, fundamental, and pricing field values for up to thousands of\nsecurities at once. Limited to 400 fields per request; the API will internally split\nsecurities into groups of 10 and fields into groups of 128 against the session's\n`MaxPendingRequests` (default 1024). Supports field overrides, EID return, formatted\nvalues, UTC timestamps, and forced delayed pricing.\n"
              },
              "response": [
                {
                  "id": "b9391de5-2976-40c1-be00-ab6ca64828f4",
